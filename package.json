{
  "name": "autodor-nextgen-redesign",
  "version": "0.1.0",
  "private": true,
  "description": "Production frontend for the Autodor homepage redesign.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11.0.0 <12"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "dev": "next dev --webpack --hostname localhost --port 3001",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier . --check",
    "format:write": "prettier . --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:update": "playwright test --update-snapshots",
    "harness:scope": "node .tools/harness/run.mjs scope",
    "harness:changed": "node .tools/harness/run.mjs changed",
    "harness:preflight": "node .tools/harness/run.mjs preflight",
    "harness:quick": "node .tools/harness/run.mjs quick",
    "harness:functional": "node .tools/harness/run.mjs functional",
    "harness:visual": "node .tools/harness/run.mjs visual",
    "harness:release": "node .tools/harness/run.mjs release",
    "harness:block": "node .tools/harness/run.mjs block",
    "harness:ci": "node .tools/harness/run.mjs ci",
    "harness:manual": "node .tools/harness/manual-gates.mjs",
    "dev:vinext": "vinext dev --port 3001",
    "build:vinext": "vinext build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1",
    "build-storybook": "storybook build",
    "icons:check": "node scripts/validate-icons.mjs",
    "icons:check:file": "node scripts/validate-icons.mjs",
    "icons:optimize": "node scripts/optimize-icons.mjs",
    "icons:visual": "node scripts/run-icons-visual.mjs"
  },
  "dependencies": {
    "next": "16.2.10",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "overrides": {
    "postcss": "8.5.19"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@cloudflare/vite-plugin": "^1.45.1",
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "4.3.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vinext/cloudflare": "1.0.0-beta.2",
    "@vitejs/plugin-react": "6.0.3",
    "@vitejs/plugin-rsc": "^0.5.28",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.10",
    "jsdom": "29.1.1",
    "prettier": "3.9.5",
    "react-server-dom-webpack": "19.2.7",
    "tailwindcss": "4.3.2",
    "typescript": "6.0.3",
    "vinext": "1.0.0-beta.2",
    "vite": "^8.1.5",
    "vitest": "4.1.10",
    "wrangler": "^4.112.0",
    "storybook": "^10.5.10",
    "@storybook/nextjs-vite": "^10.5.10",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "eslint-plugin-storybook": "^10.5.10"
  },
  "type": "module"
}
